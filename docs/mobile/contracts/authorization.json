      true,
      true,
      true,
      false,
      false,
      false
    ],
    "can_upload_project_version": [
      true,
      true,
      true,
      true,
      false,
      false
    ],
    "can_review_project": [
      true,
      true,
      true,
      true,
      true,
      false
    ],
    "can_manage_collaboration_members": [
      true,
      true,
      false,
      false,
      false,
      false
    ]
  },
  "operationCases": [
