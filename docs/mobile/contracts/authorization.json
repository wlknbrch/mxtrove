{
  "contractVersion": "0.1.1",
  "scope": "UI capability projections of accepted membership helpers; not a substitute for RLS or operation-specific resource checks",
  "roles": [
    "owner",
    "admin",
    "editor",
    "contributor",
    "reviewer",
    "viewer"
  ],
  "helperCapabilities": {
