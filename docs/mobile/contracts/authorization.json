    {
      "actorRole": "admin",
      "operation": "remove_member",
      "targetRole": "owner",
      "allowed": false
    },
    {
      "actorRole": "admin",
      "operation": "remove_member",
      "targetRole": "admin",
      "allowed": false
    },
    {
      "actorRole": "admin",
      "operation": "remove_member",
      "targetRole": "reviewer",
      "allowed": true
