TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=letsencrypt
WORKER_ENV_FILE=deploy/mxshare.vps.env

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_DRIVE_CLIENT_ID
VITE_DROPBOX_CLIENT_ID=YOUR_DROPBOX_APP_KEY
VITE_ONEDRIVE_CLIENT_ID=YOUR_MICROSOFT_ENTRA_CLIENT_ID
VITE_MEDIA_WORKER_URL=https://mxshare.wlknbrch.com/worker
VITE_WEB_PUSH_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VITE_PWA_ENABLED=true
VITE_ENABLE_DEMO_MODE=false
VITE_APP_URL=https://mxshare.wlknbrch.com

NODE_ENV=production
PORT=8080
APP_ORIGIN=https://mxshare.wlknbrch.com,https://www.mxshare.wlknbrch.com
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
WEB_PUSH_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
WEB_PUSH_SUBJECT=mailto:contact@wlknbrch.com

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=/tmp/mxshare
PROTECTED_MEDIA_DIR=/data/mxshare-protected-media
SOCIAL_PREVIEW_CACHE_DIR=/data/mxshare-protected-media/social-previews
SOCIAL_PREVIEW_CACHE_TTL_SECONDS=86400
PUBLIC_APP_URL=https://mxshare.wlknbrch.com
DATA_EXPORT_POLL_INTERVAL_MS=10000
DATA_EXPORT_BATCH_SIZE=2
DATA_EXPORT_TTL_SECONDS=86400
PROTECTED_MEDIA_SIGNING_SECRET=GENERATE_A_LONG_RANDOM_SECRET
WORKER_PUBLIC_URL=https://mxshare.wlknbrch.com/worker
MAX_UPLOAD_BYTES=524288000
MAX_ATTACHMENT_BYTES=52428800
MAX_IMAGE_ATTACHMENT_BYTES=15728640
MAX_DOCUMENT_ATTACHMENT_BYTES=20971520
PROTECTED_URL_TTL_SECONDS=300
MAX_AUDIO_DURATION_SECONDS=5400
MAX_CONCURRENT_MEDIA_JOBS=1
MEDIA_READY_TTL_SECONDS=21600
MEDIA_JOB_TIMEOUT_SECONDS=1800
PUSH_POLL_INTERVAL_MS=3000
