# Copy to deploy/selfhost.env and replace every placeholder before building.
MXTROVE_HOST=music.example.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ROUTER_PREFIX=my-music-instance
WORKER_ENV_FILE=deploy/selfhost.env
VITE_OPERATOR_NAME=Your operator name
VITE_CONTACT_EMAIL=operator@example.com
VITE_SOURCE_URL=https://github.com/YOUR_ACCOUNT/YOUR_FORK/tree/DEPLOYED_COMMIT
PUBLIC_SOURCE_URL=https://github.com/YOUR_ACCOUNT/YOUR_FORK/tree/DEPLOYED_COMMIT

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
PROTECTED_MEDIA_SIGNING_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Configure at least one provider for uploads; others may remain empty.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_DROPBOX_CLIENT_ID=
VITE_ONEDRIVE_CLIENT_ID=

# Optional web push: set all three consistently to enable it.
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operator@example.com
VITE_PWA_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_MEDIA_JOBS=1
PROTECTED_MEDIA_MIN_FREE_BYTES=1073741824
