NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=/tmp/mxshare
PROTECTED_MEDIA_DIR=/tmp/mxshare-protected-media
SOCIAL_PREVIEW_CACHE_DIR=/tmp/mxshare-protected-media/social-previews
SOCIAL_PREVIEW_CACHE_TTL_SECONDS=86400
PUBLIC_APP_URL=http://localhost:5173
DATA_EXPORT_POLL_INTERVAL_MS=10000
DATA_EXPORT_BATCH_SIZE=2
DATA_EXPORT_TTL_SECONDS=86400
PROTECTED_MEDIA_SIGNING_SECRET=
WORKER_PUBLIC_URL=http://localhost:8080
MAX_UPLOAD_BYTES=524288000
MAX_ATTACHMENT_BYTES=52428800
MAX_IMAGE_ATTACHMENT_BYTES=15728640
MAX_DOCUMENT_ATTACHMENT_BYTES=20971520
PROTECTED_URL_TTL_SECONDS=300
MAX_AUDIO_DURATION_SECONDS=5400
MAX_CONCURRENT_MEDIA_JOBS=1
MEDIA_READY_TTL_SECONDS=21600
MEDIA_JOB_TIMEOUT_SECONDS=1800
PUSH_POLL_INTERVAL_MS=3000
WORKER_INSTANCE_ID=
